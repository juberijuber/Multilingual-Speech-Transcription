# Backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5433/speech_transcription

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Speech Provider ───────────────────────────────────────────────────────────
# Options: faster_whisper | mock
SPEECH_PROVIDER=faster_whisper

# Faster-Whisper model size: tiny | base | small | medium | large-v2 | large-v3
# Recommendation: "base" for quick demos, "small" for better Hindi accuracy
WHISPER_MODEL_SIZE=base

# Device: cpu | cuda | auto
WHISPER_DEVICE=cpu

# Compute type: int8 | float16 | float32
# int8 is fastest on CPU; use float16 with CUDA
WHISPER_COMPUTE_TYPE=int8

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
